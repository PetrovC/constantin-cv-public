---
interface Props {
  title: string;
  description: string;
  lang?: string;
  variantClass?: string;
}

const { title, description, lang = 'fr', variantClass = '' } = Astro.props as Props;
const bodyClass = ['print-body', variantClass].filter(Boolean).join(' ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      @page {
        size: A4;
        margin: 10mm;
      }

      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        --print-ink: #172033;
        --print-muted: #536071;
        --print-quiet: #7a8493;
        --print-line: #d9dee7;
        --print-accent: #174c63;
        --print-accent-soft: #eef5f1;
      }

      * {
        box-sizing: border-box;
      }

      body.print-body {
        min-width: 320px;
        margin: 0;
        background: #e9edf2;
        color: var(--print-ink);
        font-size: 10pt;
        line-height: 1.42;
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .print-page {
        width: 210mm;
        min-height: 297mm;
        margin: 16px auto;
        padding: 13mm;
        background: #ffffff;
        box-shadow: 0 18px 42px rgba(23, 32, 51, 0.14);
      }

      .print-body--compact .print-page {
        padding: 9mm;
      }

      .print-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(54mm, auto);
        gap: 9mm;
        align-items: start;
        border-bottom: 1px solid var(--print-line);
        padding-bottom: 5mm;
      }

      .print-name {
        margin: 0;
        color: var(--print-ink);
        font-size: 26pt;
        line-height: 1;
        letter-spacing: 0;
      }

      .print-title {
        margin: 2.5mm 0 0;
        color: var(--print-accent);
        font-size: 12pt;
        font-weight: 800;
        line-height: 1.25;
      }

      .print-subtitle {
        margin: 2mm 0 0;
        color: var(--print-muted);
        font-size: 9.5pt;
      }

      .print-contact {
        display: grid;
        gap: 1.8mm;
        margin: 0;
        color: var(--print-muted);
        font-size: 8.8pt;
        font-style: normal;
        text-align: right;
      }

      .print-contact div {
        overflow-wrap: anywhere;
      }

      .print-content {
        display: grid;
        grid-template-columns: minmax(0, 67mm) minmax(0, 1fr);
        gap: 8mm;
        padding-top: 5mm;
      }

      .print-main,
      .print-sidebar {
        display: grid;
        align-content: start;
        gap: 5mm;
      }

      .print-section {
        display: grid;
        gap: 2.6mm;
        break-inside: avoid;
      }

      .print-section--flow {
        break-inside: auto;
      }

      .print-section-title {
        margin: 0;
        border-bottom: 1px solid var(--print-line);
        padding-bottom: 1.3mm;
        color: var(--print-accent);
        font-size: 9.2pt;
        font-weight: 900;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .print-summary {
        margin: 0;
        color: var(--print-muted);
      }

      .print-skills,
      .print-language-list,
      .print-learning-list,
      .print-mission-list {
        display: grid;
        gap: 2.2mm;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .print-skill-group {
        display: grid;
        gap: 1.1mm;
      }

      .print-skill-name,
      .print-item-title,
      .print-experience-role {
        color: var(--print-ink);
        font-weight: 850;
      }

      .print-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 1.4mm;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .print-tags li {
        border: 1px solid var(--print-line);
        border-radius: 3px;
        padding: 0.8mm 1.4mm;
        background: var(--print-accent-soft);
        color: #294354;
        font-size: 7.4pt;
        line-height: 1.15;
      }

      .print-plain-list {
        display: grid;
        gap: 1.4mm;
        margin: 0;
        padding-left: 4mm;
        color: var(--print-muted);
      }

      .print-language-list li,
      .print-education-item,
      .print-experience {
        break-inside: avoid;
      }

      .print-item-meta,
      .print-period {
        color: var(--print-quiet);
        font-size: 8.2pt;
        font-weight: 750;
      }

      .print-education-list,
      .print-experience-list {
        display: grid;
        gap: 3.2mm;
      }

      .print-education-item,
      .print-experience {
        display: grid;
        gap: 1.5mm;
      }

      .print-experience-header {
        display: flex;
        justify-content: space-between;
        gap: 5mm;
        border-top: 1px solid var(--print-line);
        padding-top: 2.5mm;
      }

      .print-experience:first-child .print-experience-header {
        border-top: 0;
        padding-top: 0;
      }

      .print-company {
        margin: 0;
        color: var(--print-accent);
        font-size: 9.2pt;
        font-weight: 900;
      }

      .print-experience-role {
        margin: 0.6mm 0 0;
      }

      .print-mission {
        display: grid;
        gap: 1.3mm;
        break-inside: avoid;
      }

      .print-mission-title {
        margin: 0;
        color: var(--print-ink);
        font-size: 8.8pt;
        font-weight: 850;
      }

      .print-body--compact {
        font-size: 8.7pt;
        line-height: 1.34;
      }

      .print-body--compact .print-name {
        font-size: 22pt;
      }

      .print-body--compact .print-title {
        font-size: 10.5pt;
      }

      .print-body--compact .print-subtitle,
      .print-body--compact .print-contact,
      .print-body--compact .print-period {
        font-size: 7.8pt;
      }

      .print-body--compact .print-content {
        grid-template-columns: minmax(0, 62mm) minmax(0, 1fr);
        gap: 5mm;
        padding-top: 4mm;
      }

      .print-body--compact .print-main,
      .print-body--compact .print-sidebar {
        gap: 3.5mm;
      }

      .print-body--compact .print-section {
        gap: 1.8mm;
      }

      .print-body--compact .print-tags li {
        font-size: 6.8pt;
        padding: 0.65mm 1.1mm;
      }

      @media print {
        body.print-body {
          background: #ffffff;
        }

        .print-page {
          width: auto;
          min-height: auto;
          margin: 0;
          padding: 0;
          box-shadow: none;
        }
      }

      @media (max-width: 820px) {
        .print-page {
          width: min(100% - 18px, 210mm);
          min-height: auto;
          padding: 18px;
        }

        .print-header,
        .print-content {
          grid-template-columns: 1fr;
        }

        .print-contact {
          text-align: left;
        }
      }
    </style>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
