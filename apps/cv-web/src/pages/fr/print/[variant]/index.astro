---
import PrintCvDocument from '../../../../components/print/PrintCvDocument.astro';
import PrintLayout from '../../../../layouts/PrintLayout.astro';
import {
  loadGeneratedPrintCvDocument,
  type GeneratedPrintCvDocument,
  type PrintCvVariantKey
} from '../../../../lib/printCvData';
import process from 'node:process';

interface PrintRoute {
  slug: string;
  variant: PrintCvVariantKey;
  variantClass?: string;
  title: (cv: GeneratedPrintCvDocument) => string;
  description: (cv: GeneratedPrintCvDocument) => string;
}

interface Props {
  route: PrintRoute;
}

const printRoutes: PrintRoute[] = [
  {
    slug: 'one-page',
    variant: 'onePage',
    variantClass: 'print-body--compact',
    title: (cv) => `${cv.profile.fullName} | CV une page`,
    description: (cv) => cv.summary.short
  },
  {
    slug: 'full-dev',
    variant: 'fullDev',
    title: (cv) => `${cv.profile.fullName} | CV developpeur fullstack`,
    description: (cv) => cv.summary.long
  }
];

export function getStaticPaths() {
  if (process.env.CV_WEB_BUILD_MODE !== 'print') {
    return [];
  }

  return printRoutes.map((route) => ({
    params: { variant: route.slug },
    props: { route }
  }));
}

const { route } = Astro.props as Props;
const cv = await loadGeneratedPrintCvDocument('fr');
---

<PrintLayout
  title={route.title(cv)}
  description={route.description(cv)}
  lang="fr"
  variantClass={route.variantClass}
>
  <PrintCvDocument cv={cv} variant={route.variant} />
</PrintLayout>
