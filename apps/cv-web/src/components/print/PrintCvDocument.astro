---
import { formatPeriod } from '../../lib/localization';
import type {
  GeneratedPrintCvDocument,
  GeneratedPrintCvExperience,
  GeneratedPrintCvMission,
  GeneratedPrintCvSkillGroup,
  PrintCvVariantKey
} from '../../lib/printCvData';

interface Props {
  cv: GeneratedPrintCvDocument;
  variant: PrintCvVariantKey;
}

const { cv, variant } = Astro.props as Props;
const isOnePage = variant === 'onePage';
const experiences = cv[variant].experiences;
const title = isOnePage ? 'CV une page' : 'CV developpeur fullstack';
const summary = isOnePage ? cv.summary.short : cv.summary.long;
const skillGroups = isOnePage ? cv.skills.slice(0, 4) : cv.skills;
const education = isOnePage ? cv.education.slice(0, 2) : cv.education;
const softSkills = isOnePage ? cv.softSkills.slice(0, 2) : cv.softSkills;

const contactItems = [
  { label: 'Email', value: cv.profile.contact.email },
  { label: 'Telephone', value: cv.profile.contact.phone },
  { label: 'Localisation', value: cv.profile.contact.location },
  { label: 'LinkedIn', value: cv.profile.links.linkedin, href: cv.profile.links.linkedin }
].filter((item) => Boolean(item.value));

const getSkillItems = (group: GeneratedPrintCvSkillGroup) =>
  isOnePage ? group.items.slice(0, 8) : group.items;

const getMissionTags = (mission: GeneratedPrintCvMission) =>
  isOnePage ? mission.tags.slice(0, 5) : mission.tags;

const getMissionBullets = (mission: GeneratedPrintCvMission) =>
  isOnePage ? mission.bullets.slice(0, 1) : mission.bullets;

const getExperienceMissions = (experience: GeneratedPrintCvExperience) =>
  isOnePage ? experience.missions.slice(0, 3) : experience.missions;
---

<article class="print-page" aria-labelledby="print-title">
  <header class="print-header">
    <div>
      <p class="print-section-title">{title}</p>
      <h1 id="print-title" class="print-name">{cv.profile.fullName}</h1>
      <p class="print-title">{cv.profile.title}</p>
      <p class="print-subtitle">{cv.profile.subtitle}</p>
    </div>

    <address class="print-contact">
      {
        contactItems.map((item) => (
          <div>
            <strong>{item.label}</strong><br />
            {item.href ? <a href={item.href}>{item.value}</a> : item.value}
          </div>
        ))
      }
    </address>
  </header>

  <div class="print-content">
    <aside class="print-sidebar">
      <section class="print-section" aria-labelledby="print-skills-title">
        <h2 id="print-skills-title" class="print-section-title">Competences</h2>
        <div class="print-skills">
          {
            skillGroups.map((group) => (
              <section class="print-skill-group">
                <div class="print-skill-name">{group.name}</div>
                <ul class="print-tags">
                  {getSkillItems(group).map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </section>

      {
        softSkills.length > 0 && (
          <section class="print-section" aria-labelledby="print-soft-skills-title">
            <h2 id="print-soft-skills-title" class="print-section-title">Savoir-etre</h2>
            <div class="print-skills">
              {softSkills.map((group) => (
                <section class="print-skill-group">
                  <div class="print-skill-name">{group.name}</div>
                  <ul class="print-plain-list">
                    {(isOnePage ? group.items.slice(0, 1) : group.items).map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </section>
        )
      }

      <section class="print-section" aria-labelledby="print-education-title">
        <h2 id="print-education-title" class="print-section-title">Formation</h2>
        <div class="print-education-list">
          {
            education.map((item) => (
              <section class="print-education-item">
                <div>
                  <div class="print-item-title">{item.degree}</div>
                  <div class="print-item-meta">
                    {item.institution} | {formatPeriod(item.period, 'fr')}
                  </div>
                </div>
                {!isOnePage && item.description && <div class="print-summary">{item.description}</div>}
              </section>
            ))
          }
        </div>
      </section>

      {
        !isOnePage && cv.continuousLearning && (
          <section class="print-section" aria-labelledby="print-learning-title">
            <h2 id="print-learning-title" class="print-section-title">{cv.continuousLearning.title}</h2>
            <ul class="print-learning-list">
              {cv.continuousLearning.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="print-section" aria-labelledby="print-languages-title">
        <h2 id="print-languages-title" class="print-section-title">Langues</h2>
        <ul class="print-language-list">
          {
            cv.spokenLanguages.map((language) => (
              <li>
                <span class="print-item-title">{language.name}</span>
                <span class="print-item-meta">{language.level}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>

    <main class="print-main">
      <section class="print-section" aria-labelledby="print-profile-title">
        <h2 id="print-profile-title" class="print-section-title">Profil</h2>
        <p class="print-summary">{summary}</p>
      </section>

      <section class="print-section print-section--flow" aria-labelledby="print-experience-title">
        <h2 id="print-experience-title" class="print-section-title">Experience</h2>
        <div class="print-experience-list">
          {
            experiences.map((experience) => (
              <article class="print-experience">
                <header class="print-experience-header">
                  <div>
                    <p class="print-company">{experience.company}</p>
                    <p class="print-experience-role">{experience.role}</p>
                  </div>
                  <div class="print-period">{formatPeriod(experience.period, 'fr')}</div>
                </header>

                <div class="print-mission-list">
                  {getExperienceMissions(experience).map((mission) => (
                    <section class="print-mission">
                      <h3 class="print-mission-title">
                        {mission.name} - {mission.title}
                      </h3>

                      {getMissionTags(mission).length > 0 && (
                        <ul class="print-tags">
                          {getMissionTags(mission).map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      )}

                      {getMissionBullets(mission).length > 0 && (
                        <ul class="print-plain-list">
                          {getMissionBullets(mission).map((bullet) => (
                            <li>{bullet}</li>
                          ))}
                        </ul>
                      )}
                    </section>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</article>
